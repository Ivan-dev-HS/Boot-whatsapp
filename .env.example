# Ruta del fichero SQLite (se crea solo si no existe)
DATABASE_PATH=./data/boot-whatsapp.sqlite

# Puerto en el que escucha la aplicación web
PORT=3000

# Umbral de similitud (0-1) para considerar que un producto de la lista
# coincide con un producto en oferta. Mas alto = coincidencias mas estrictas.
MATCH_THRESHOLD=0.6

# Usa los scrapers de prueba (datos simulados) en vez de los reales.
# Utilo para probar la app sin depender de las webs de los supermercados.
USE_MOCK_SCRAPERS=false
