# Ruta del fichero SQLite (se crea solo si no existe)
DATABASE_PATH=./data/boot-whatsapp.sqlite

# IDs de chat de WhatsApp autorizados a usar el bot, separados por comas.
# Deja vacio para permitir cualquier chat (no recomendado).
# El formato de un ID de chat es "34600111222@c.us" (chat individual)
# o "1234567890-1234567890@g.us" (grupo). El bot los imprime por consola
# cuando recibe un mensaje, para que puedas copiarlos.
ALLOWED_CHAT_IDS=

# Expresion cron (hora del servidor) para comprobar ofertas automaticamente.
# Por defecto: todos los dias a las 09:00
ALERTS_CRON=0 9 * * *

# Umbral de similitud (0-1) para considerar que un producto de la lista
# coincide con un producto en oferta. Mas alto = coincidencias mas estrictas.
MATCH_THRESHOLD=0.6

# Usa los scrapers de prueba (datos simulados) en vez de los reales.
# Utilo para probar el bot sin depender de las webs de los supermercados.
USE_MOCK_SCRAPERS=false
