{
  "name": "boot-whatsapp",
  "version": "1.0.0",
  "description": "Aplicación web para gestionar una lista de la compra y comparar precios entre Lidl, Aldi, Plus Fresc y Esclat. Incluye un bot de WhatsApp opcional para conectar más adelante.",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "demo": "ts-node --transpile-only src/cli.ts",
    "bot:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "bot:start": "node dist/index.js",
    "test": "node --loader ts-node/esm --test src/**/*.test.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.26.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  }
}
